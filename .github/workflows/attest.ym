name: サイトの証明書を作成

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  attest:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
      attestations: write

    steps:
      - uses: actions/checkout@v4

      - name: サイトをZIPにする
        run: |
          zip owners-portal.zip index.html style.css script.js

      - name: 証明書を作成
        uses: actions/attest@v4
        with:
          subject-path: owners-portal.zip
